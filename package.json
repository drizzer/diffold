{
  "name": "diffold",
  "version": "0.0.2",
  "description": "Compare directories and show differences with color-coded output",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "main": "dist/index.js",
  "bin": {
    "diffold": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --outfile=dist/index.js --format=esm --banner:js=\"#!/usr/bin/env node\" --external:\"node:*\" --target=es2022",
    "prepare": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test && bun run test && bun run build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:bun": "bun test",
    "test:deno": "deno test --allow-read --allow-write --allow-env --allow-run --allow-sys tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "bun run build && node dist/index.js",
    "start:bun": "bun index.ts",
    "start:deno": "deno run --allow-read --allow-env --allow-sys index.ts",
    "start:dist": "node dist/index.js"
  },
  "files": [
    "dist/",
    "assets/demo.svg",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "directory",
    "diff",
    "comparison",
    "cli",
    "bun",
    "node",
    "deno",
    "typescript"
  ],
  "license": "MIT",
  "author": "drizzer",
  "homepage": "https://github.com/drizzer/diffold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizzer/diffold.git"
  },
  "bugs": {
    "url": "https://github.com/drizzer/diffold/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/drizzer"
    },
    {
      "type": "ko_fi",
      "url": "https://ko-fi.com/drizzer"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/drizzer"
    }
  ]
}
